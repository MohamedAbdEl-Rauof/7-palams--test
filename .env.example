# Copy to .env.local and fill in real values. NEVER commit .env.local.
#
# The same three REQUIRED values must be set in Vercel -> Settings ->
# Environment Variables before the first deploy. See "Deploying" in README.md.

# REQUIRED. ClickUp personal API token (Settings -> Apps -> API Token).
# WARNING: this token is workspace-wide and grants read/write on every task.
# Server-side only — it must never appear in a NEXT_PUBLIC_ variable.
CLICKUP_TOKEN=pk_xxxxxxxxxxxxx

# REQUIRED. The "مشهد زيارة" list. Discovered via the API — see README.
CLICKUP_LIST_ID=

# REQUIRED. Shared secret for the embed URL: https://<domain>/?k=<this>
# Generate with: openssl rand -hex 32
# Use a DIFFERENT value in production than locally.
# Note: this is obscurity, not authentication — see README security section.
DASHBOARD_SECRET=

# OPTIONAL, reference only. Nothing in the app reads this; it exists so the
# ID-discovery curls in README.md can be re-run. Safe to leave unset in Vercel.
CLICKUP_TEAM_ID=
