# Copy to .env.local and fill in real values. NEVER commit .env.local.

# ClickUp personal API token (Settings -> Apps -> API Token).
# WARNING: this token is workspace-wide and grants read/write on every task.
# Server-side only — it must never appear in a NEXT_PUBLIC_ variable.
CLICKUP_TOKEN=pk_xxxxxxxxxxxxx

# Discovered in Phase 2 via the ClickUp API (see README).
CLICKUP_LIST_ID=
CLICKUP_TEAM_ID=

# Shared secret for the embed URL. Generate with: openssl rand -hex 32
# Note: this is obscurity, not authentication — see README security section.
DASHBOARD_SECRET=

# Safe to expose: NEXT_PUBLIC_* values are inlined into the client bundle.
NEXT_PUBLIC_APP_NAME=Noor Dashboard
